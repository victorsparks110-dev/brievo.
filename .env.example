# Frontend environment variables
# Copy this file to .env and fill in the values.
# Never commit .env files containing real credentials.

# Backend API base URL — used for all API requests
VITE_API_BASE_URL=http://localhost:5000

# When 'true', the application runs in development demo mode with the
# floating demo account switcher enabled. This does NOT affect future
# production authentication.
VITE_DEMO_MODE=true
