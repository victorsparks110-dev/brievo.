# Backend environment variables
# Copy this file to .env and fill in the values.
# Never commit .env files containing real credentials.

# Server port
PORT=5000

# MongoDB connection string
MONGODB_URI=your_mongodb_connection_string

# JWT secret — must be at least 32 cryptographically random characters in production.
# Required at startup. The server will not start without it.
JWT_SECRET=your_secure_random_secret_at_least_32_characters

# Support team email — receives notifications for new support tickets
SUPPORT_EMAIL=your-support-email@example.com

# Frontend application URL — used in email links and CORS
APP_URL=http://localhost:5173

# Node environment (development | production)
NODE_ENV=development

# Resend email provider — get your API key from https://resend.com
RESEND_API_KEY=re_your_resend_api_key

# Sender email address — must be from a verified Resend domain
EMAIL_FROM=noreply@yourdomain.com

# Enable email sending (set to "true" to send real emails via Resend)
EMAIL_ENABLED=true

# Dev-only verification bypass: when "true", verification code "000000" is accepted.
# MUST be "false" or omitted in production. The server will refuse to start
# if NODE_ENV=production and this is "true".
EMAIL_VERIFICATION_DEV_MODE=false